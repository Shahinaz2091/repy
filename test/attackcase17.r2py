if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

f = ABopenfile("testfile.txt", True)

assert(f.readat(None, 0) == "SE")

# Valid B, length 4
f.writeat("S12E", 0)

# Invalid overwrite at index 3, still inside length
try:
  f.writeat("X", 3)
except:
  pass

# Append at exactly length 4, not greater
f.writeat("E", 4)

f.close()

f = ABopenfile("testfile.txt", False)

assert(f.readat(None, 0) == "S12EE")

f.close()
