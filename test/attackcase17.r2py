if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

# Create AB file
f = ABopenfile("testfile.txt", True)

# A starts as valid SE
assert(f.readat(None, 0) == "SE")

# Write invalid data to B.
# It starts with S but does not end with E.
f.writeat("SHOW", 0)

# Close. Correct monitor should NOT commit SHOW to A.
f.close()

# Reopen same file
f = ABopenfile("testfile.txt", False)

# Append at the end of existing B data.
# len("SHOW") == 4, so offset 4 is legal append position.
f.writeat("ME", 4)

# Now B becomes SHOWME, which starts with S and ends with E.
f.close()

# Reopen and check A
f = ABopenfile("testfile.txt", False)

# Vulnerable monitor incorrectly commits SHOWME to A.
assert(f.readat(None, 0) == "SHOWME")

f.close()
