if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

f = ABopenfile("testfile.txt", True)

assert(f.readat(None, 0) == "SE")

# Step 1: make B length 1 with invalid data
f.writeat("A", 0)

# Step 2: write valid ending at the append position
f.writeat("E", 1)

f.close()

f = ABopenfile("testfile.txt", False)

# Correct behavior: A should remain "SE"
# Bad behavior: invalid B length handling may corrupt/commit B
assert(f.readat(None, 0) == "AE")

f.close()
