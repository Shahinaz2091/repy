if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

f = ABopenfile("testfile.txt", True)

# A starts valid
assert(f.readat(None, 0) == "SE")

# Invalid write to B.
# This should NOT be accepted as a valid staged file,
# but a flawed monitor may still update B's length.
f.writeat("S", 0)

# Now append at offset 1.
# Offset 1 is not greater than current B length if the invalid write changed length.
f.writeat("E", 1)

f.close()

f = ABopenfile("testfile.txt", False)

# If the monitor is flawed, B became "SE" through invalid intermediate state
# and may be committed incorrectly.
assert(f.readat(None, 0) != "SE")

f.close()
