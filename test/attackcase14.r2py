if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

myfile = ABopenfile("testfile.txt", True)

# Write 1 - invalid: offset 0 <= len("SE")=2, grows B from 2 to 5 chars
myfile.writeat("hello", 0)

myfile.readat(None, 0)

# Write 2 - invalid: append at offset == len("hello")=5
myfile.writeat("world", 5)

# Write 3 - invalid: append at offset == len("helloworld")=10
myfile.writeat("12345", 10)

myfile.readat(None, 0)

# Write 4 - invalid: append at offset == len("helloworld12345")=15
myfile.writeat("67890", 15)

# Patch endpoints to make B appear valid
myfile.writeat("S", 0)
myfile.writeat("E", 19)

myfile.close()

myfile = ABopenfile("testfile.txt", False)
myfile.readat(None, 0)
myfile.close()
