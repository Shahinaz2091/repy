if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

f1 = ABopenfile("testfile.txt", True)
f2 = ABopenfile("testfile.txt", False)

f1.writeat("S111E", 0)
f2.writeat("S222E", 0)

f1.close()
f2.close()

f = ABopenfile("testfile.txt", False)

# A correct monitor should not allow both handles to race on same file.
# If both were allowed, final content may be inconsistent.
assert(f.readat(None, 0) != "S111E")

f.close()
