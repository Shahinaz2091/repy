if "testfile.txt.a" in listfiles():
  removefile("testfile.txt.a")
if "testfile.txt.b" in listfiles():
  removefile("testfile.txt.b")

myfile = ABopenfile("testfile.txt", True)

def thread_write_s():
  for i in range(100):
    myfile.writeat("S", 0)

def thread_write_garbage():
  for i in range(100):
    myfile.writeat("corruptE", 1)

createthread(thread_write_s)
createthread(thread_write_garbage)
sleep(2)

myfile.close()

myfile = ABopenfile("testfile.txt", False)
data = myfile.readat(None, 0)
myfile.close()
